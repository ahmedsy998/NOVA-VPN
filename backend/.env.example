# NOVA VPN Backend Environment Variables
PORT=8443
NODE_ENV=production

# PostgreSQL connection string
DATABASE_URL=postgresql://novavpn:CHANGE_ME_STRONG_PASSWORD@postgres:5432/novavpn

# JWT Signing Secret (minimum 64 random hex characters)
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX_SECRET

# Admin API Key for managing countries, cities, and VPN servers
ADMIN_API_KEY=CHANGE_ME_ADMIN_SECRET_KEY

# Optional: WireGuard Node Management Webhook / Agent Token
WG_AGENT_SECRET=CHANGE_ME_WG_NODE_AGENT_TOKEN

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://admin.novavpn.example.com
